# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mentor_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/mentor_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Email (optional - uses placeholder by default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mentorplatform.com

# Frontend
FRONTEND_URL=http://localhost:3000

# WebRTC
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
